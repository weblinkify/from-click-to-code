{
  "name": "kids-todo-app",
  "version": "1.0.0",
  "description": "A small, real todo web app for learning how websites work, from idea to production.",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:security": "node --test \"tests/security/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:security",
    "check:links": "node scripts/check-links.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weblinkify/from-click-to-code.git"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.12.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3"
  },
  "type": "module"
}
