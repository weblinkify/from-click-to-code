{
  "name": "kids-todo-app",
  "version": "1.0.0",
  "description": "A small, real todo web app for learning how websites work, from idea to production.",
  "private": true,
  "license": "ISC",
  "main": "backend/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --watch --env-file-if-exists=.env backend/server.js",
    "lint": "eslint .",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test": "npm run test:unit && npm run test:integration"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weblinkify/from-click-to-code.git"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "supertest": "^7.3.1"
  }
}
