# .env.example
# A TEMPLATE for your settings. Copy it to make your own private file:
#
#     cp .env.example .env
#
# The real .env is listed in .gitignore, so your secrets never go to GitHub.
# This example file has NO real secrets in it, so it's safe to share.

# Which door number (port) the app listens on.
PORT=3000

# Where the SQLite database file is kept.
DB_PATH=data/todos.db

# "development" on your computer, "production" on a real server.
NODE_ENV=development

# A long random secret used to sign security tokens.
# Make your own with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-secret

# true = cookies only travel over HTTPS. Turn on when the site has HTTPS.
# (If left empty, it's on in production and off in development.)
COOKIE_SECURE=

# How many login tries are allowed, and for how many minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# How hard bcrypt works to scramble passwords (12 is a good choice).
BCRYPT_ROUNDS=12

# Set to true only when running behind a cloud load balancer / proxy.
TRUST_PROXY=false

# INCIDENT DRILL ONLY: true makes every database call fail on purpose.
# See lessons/20-incident-drill.md. Keep this false!
BREAK_DATABASE=false
